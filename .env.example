# Copy to .env and fill in your own keys from https://www.trafiklab.se
# Never commit .env

# GTFS Regional Static (sl.zip)
TRAFIKLAB_GTFS_STATIC_KEY=

# GTFS Regional Realtime (VehiclePositions, TripUpdates)
TRAFIKLAB_GTFS_RT_KEY=

# Backend
PORT=3000
# How often the backend polls the realtime feed (ms). Mind your API quota.
RT_POLL_INTERVAL_MS=5000
