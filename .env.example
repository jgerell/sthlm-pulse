# Copy to .env and fill in your own keys from https://www.trafiklab.se
# Never commit .env

# GTFS Regional Static (sl.zip). Required.
TRAFIKLAB_GTFS_STATIC_KEY=

# GTFS Regional Realtime. Optional: without it the map runs on the timetable
# alone. Used for delays (TripUpdates, at most every 2 minutes) and disruptions
# (ServiceAlerts, at most every 15 minutes), fetched only while someone has the
# site open. Bronze quota is ~1 000 requests / day.
TRAFIKLAB_GTFS_RT_KEY=

# Trafikverket's open API (https://data.trafikverket.se). Optional: shows
# regional and long-distance trains (SJ, Mälartåg, Arlanda Express...) by GPS,
# fetched at most every 10 seconds while someone has the site open, and the
# road ferries' departures (every 30 minutes).
TRAFIKVERKET_API_KEY=

# AISStream (https://aisstream.io). Optional: shows large ships (Finland
# ferries, cargo ships...) from AIS. The server streams them only while someone
# has the site open.
AISSTREAM_API_KEY=

# Port for the server. In development the web dev server proxies /api to it;
# in production (npm run build, then npm start) it serves the whole site.
API_PORT=4280

# Production with Docker Compose only: the site's domain, for which Caddy fetches
# an HTTPS certificate (point the domain's DNS at the server first). Leave empty
# to serve plain HTTP on the server's IP address.
SITE_ADDRESS=
